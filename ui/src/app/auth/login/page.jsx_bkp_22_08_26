            <input
              className="f-input"
              type="email"
              placeholder="you@email.com"
              value={email}
              onChange={(e) => setEmail(e.target.value)}
            />
            {errors.email && (
              <div className="f-error">Please enter a valid email address.</div>
            )}
          </div>

          {/* PASSWORD */}
