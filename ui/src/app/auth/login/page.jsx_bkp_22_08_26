          <div className="lp-feat">
            <div className="lp-feat-icon">🤝</div>
            <div className="lp-feat-text">
              <strong>Community Access</strong>
              Join meetups, connect with Mumbaikars and share your stories.
            </div>
          </div>

          <div className="lp-feat">
            <div className="lp-feat-icon">🚨</div>
            <div className="lp-feat-text">
              <strong>Fraud Alerts</strong>
              Get notified about scams and fraud reports in your area.
            </div>
          </div>

          <div className="lp-feat">
            <div className="lp-feat-icon">🌆</div>
            <div className="lp-feat-text">
              <strong>Your Mumbai Dashboard</strong>
              Everything personalised to your neighbourhood.
            </div>
          </div>
        </div>
      </div>

      {/* RIGHT PANEL */}
      <div className="right-panel">
        <form onSubmit={submitLogin} className="form-card">
